---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandPattern from '../../components/BrandPattern.astro';
import MevPillarsBand from '../../components/MevPillarsBand.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import { site } from '../../data/site';

const description =
  'Seis pilares da medicina do estilo de vida em Curitiba com a Dra. Ligiana Maffini: alimentação, movimento, sono, estresse, conexões e redução de tóxicos. Abordagem MEV, não especialidade CRM. CRM/PR 17731.';

const pilaresFaq = [
  {
    question: 'O que são os seis pilares da medicina do estilo de vida?',
    answer:
      'Alimentação, movimento, sono, gerenciamento do estresse, conexões sociais e redução de tóxicos. A Dra. Ligiana Maffini, médica de família em Curitiba, usa esses eixos na consulta. CRM/PR 17731.',
  },
  {
    question: 'Pilares MEV substituem a consulta de medicina de família?',
    answer:
      'Não. Os pilares organizam a abordagem de estilo de vida dentro da consulta de família. MEV não é especialidade no CRM. Leia a página de medicina do estilo de vida em Curitiba neste site.',
  },
] as const;
---

<BaseLayout
  title="Pilares da medicina do estilo de vida em Curitiba"
  description={description}
  path="/pilares/"
  faqItems={pilaresFaq}
>
  <section class="hero-glow relative overflow-hidden border-b border-line/70">
    <BrandPattern />
    <div class="container-site relative py-16 md:py-20">
      <p class="eyebrow" data-hero-eyebrow>Medicina do Estilo de Vida · MEV</p>
      <h1 class="heading-display mt-3 max-w-3xl" data-hero-title>
        Seis pilares da medicina do estilo de vida em Curitiba com a Dra. Ligiana Maffini. {site.crm}.
      </h1>
      <p class="prose-site mt-4 max-w-2xl" data-hero-subtitle>
        Alimentação, movimento, sono, gerenciamento do estresse, conexões sociais e redução de tóxicos —
        integrados à consulta de família no Cristo Rei, como abordagem (não especialidade CRM).
        {site.fullName}. Agende: WhatsApp {site.phone}.
      </p>
    </div>
  </section>

  <MevPillarsBand
    useAccordion={true}
    segmentActive="pilares"
    title="Os seis pilares na prática clínica"
    subtitle="Clique em cada pilar para ler o significado clínico e como entra na consulta."
  />

  <section class="section-marble border-t border-line/70 py-16 md:py-20">
    <div class="container-site max-w-3xl">
      <p class="eyebrow" data-eyebrow>Perguntas frequentes</p>
      <h2 class="heading-section mt-3" data-section-title>Pilares e consulta de família</h2>
      <div class="mt-8">
        <FaqAccordion items={pilaresFaq} idPrefix="pilares" />
      </div>
    </div>
  </section>

  <section class="section-marble border-t border-line/70 py-16 md:py-20">
    <div class="container-site max-w-2xl text-center" data-cta-block>
      <p class="prose-site">
        Conteúdo educativo — não substitui consulta. {site.crm} · {site.rqe}
      </p>
      <a href={site.whatsapp} class="btn-primary mt-6" target="_blank" rel="noopener noreferrer" data-magnetic>
        Agendar pelo WhatsApp
      </a>
      <p class="mt-6 prose-site">
        <a href="/medicina-do-estilo-de-vida/" class="font-medium text-gold-deep hover:underline">
          Medicina do estilo de vida em Curitiba — abordagem da Dra. Ligiana
        </a>
      </p>
      <p class="mt-4 prose-site">
        Outras páginas da Dra. Ligiana Maffini, médica de família em Curitiba:
        <a href="/prevencao/" class="font-medium text-gold-deep hover:underline">prevenção</a>,
        <a href="/saude-da-mulher/" class="font-medium text-gold-deep hover:underline">saúde da mulher 40+</a>,
        <a href="/menopausa/" class="font-medium text-gold-deep hover:underline">menopausa</a>,
        <a href="/emagrecimento/" class="font-medium text-gold-deep hover:underline">emagrecimento clínico</a>
        e
        <a href="/longevidade/" class="font-medium text-gold-deep hover:underline">longevidade</a>.
      </p>
      <p class="mt-4">
        <a href="/especialidades/" class="link-nav">Todas as especialidades</a>
      </p>
    </div>
  </section>
</BaseLayout>
