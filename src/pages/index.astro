---
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import MarqueeBand from '../components/MarqueeBand.astro';
import PhotoStrip from '../components/PhotoStrip.astro';
import BrandPattern from '../components/BrandPattern.astro';
import BrandImage from '../components/BrandImage.astro';
import SpecialtyCardBand from '../components/SpecialtyCardBand.astro';
import MevPillarsBand from '../components/MevPillarsBand.astro';
import { site, services } from '../data/site';
import { photos, homeGallery } from '../data/photos';

const description =
  'Dra. Ligiana Maffini, médica de família e medicina do estilo de vida em Curitiba (Cristo Rei). CRM/PR 17731. Consultas presenciais e teleconsulta.';
---

<BaseLayout title={site.name} description={description} path="/">
  <section class="hero-glow relative overflow-hidden border-b border-line/70">
    <BrandPattern />
    <div class="container-site relative grid gap-10 py-16 md:grid-cols-[1.05fr_0.95fr] md:items-center md:py-24 lg:py-28">
      <div>
        <p class="eyebrow" data-hero-eyebrow>Curitiba · Cristo Rei</p>
        <h1 class="heading-display mt-4 max-w-2xl text-balance" data-hero-title>
          Dra. Ligiana Maffini — médica de família e medicina do estilo de vida em Curitiba — {site.crm}.
        </h1>
        <p class="prose-site mt-6 max-w-xl" data-hero-subtitle>
          {site.specialtyShort}. Consultas longas, longevidade e saúde integral para mulheres 40+,
          presencialmente em Curitiba e por teleconsulta.
        </p>
        <div class="mt-8 flex flex-wrap gap-3" data-hero-cta>
          <a href={site.whatsapp} class="btn-primary" target="_blank" rel="noopener noreferrer" data-magnetic>
            Agendar pelo WhatsApp
          </a>
          <a href="/abordagem" class="btn-secondary">Conhecer a abordagem</a>
        </div>
      </div>

      <figure class="relative" data-hero-media>
        <div class="photo-frame">
          <div data-parallax>
            <Photo
              src={photos.hero}
              alt="Dra. Ligiana Maffini, médica de família em Curitiba, em retrato profissional"
              priority={true}
            />
          </div>
        </div>
      </figure>
    </div>
  </section>

  <MarqueeBand />

  <section class="marble-surface relative overflow-hidden py-16 md:py-24" data-services-section>
    <div class="service-spotlight" data-service-spotlight aria-hidden="true"></div>
    <div class="container-site relative">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow" data-eyebrow>Como posso ajudar</p>
        <h2 class="heading-section mt-3" data-section-title>Atendimento pensado para a sua fase de vida</h2>
        <p class="prose-site mt-4">
          Mais de 25 anos de experiência clínica, incluindo SUS e Prefeitura, com foco atual em
          medicina preventiva, estilo de vida e acompanhamento contínuo.
        </p>
      </div>

      <div class="mt-10 grid gap-5 sm:grid-cols-2" data-services-showcase>
        {
          services.map((service, index) => (
            <article
              class="service-card group"
              data-service-card
              data-tilt-card
              data-service-expand
            >
              <span class="service-card-shine" data-service-shine aria-hidden="true"></span>
              <span class="relative font-display text-4xl text-gold/30" data-service-number>
                {String(index + 1).padStart(2, '0')}
              </span>
              <div class="relative mb-4 mt-4 h-px w-10 origin-left bg-gold" data-line-accent></div>
              <h3 class="relative font-display text-2xl text-ink" data-split-title>{service.title}</h3>
              <p class="relative prose-site mt-3 text-base" data-service-description>{service.description}</p>
              <button
                type="button"
                class="relative mt-5 inline-flex items-center gap-2 text-sm font-medium text-gold-deep"
                data-service-toggle
                aria-expanded="false"
              >
                Saiba mais
                <span aria-hidden="true">→</span>
              </button>
              <a
                href={site.whatsapp}
                class="relative mt-3 inline-flex translate-y-2 items-center gap-2 text-sm font-medium text-gold-deep opacity-0 transition-[opacity,transform] duration-300"
                data-service-cta
                target="_blank"
                rel="noopener noreferrer"
                tabindex="-1"
                hidden
              >
                Agendar consulta
                <span aria-hidden="true">→</span>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <PhotoStrip title="Retratos de cuidado e presença" items={homeGallery} />

  <SpecialtyCardBand />

  <MevPillarsBand />

  <section class="section-rose relative overflow-hidden border-y border-line/70">
    <BrandPattern />
    <div class="container-site relative grid gap-8 py-16 md:grid-cols-2 md:items-center md:py-20">
      <div class="photo-frame" data-reveal>
        <div data-parallax>
          <Photo
            src={photos.seated}
            alt="Dra. Ligiana Maffini em retrato profissional no consultório"
            aspect="portrait"
            class="object-[center_20%]"
          />
        </div>
      </div>
      <div data-reveal>
        <p class="eyebrow" data-eyebrow>Por que escolher</p>
        <h2 class="heading-section mt-3" data-section-title>Consultas longas, decisões compartilhadas</h2>
        <p class="prose-site mt-4">
          A clínica particular, aberta em 2024, nasceu da vontade de oferecer tempo, continuidade
          e uma relação médico-paciente mais próxima. Cada encontro considera rotina, sono,
          alimentação, movimento, saúde emocional e objetivos de longo prazo.
        </p>
        <a href="/sobre" class="btn-secondary mt-6">Sobre a Dra. Ligiana</a>
      </div>
    </div>
  </section>

  <section class="container-site py-16 md:py-24">
    <div class="card-soft mx-auto max-w-3xl text-center" data-cta-block>
      <BrandImage variant="mark" />
      <p class="eyebrow mt-6" data-eyebrow>Próximo passo</p>
      <h2 class="heading-section mx-auto mt-3 max-w-xl" data-section-title>Agende sua consulta com calma e atenção</h2>
      <p class="prose-site mx-auto mt-4 max-w-lg">
        WhatsApp {site.phone} · {site.instagram.personalHandle} · {site.address.neighborhood}, {site.address.city}
      </p>
      <a href={site.whatsapp} class="btn-primary mt-8" target="_blank" rel="noopener noreferrer" data-magnetic>
        Falar no WhatsApp
      </a>
    </div>
  </section>
</BaseLayout>
