---
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import { site } from '../data/site';
import aboutPhoto from '../assets/images/corpotodojaleco.jpg';
import portraitPhoto from '../assets/images/frontalrosto.jpg';
import penPhoto from '../assets/images/frontalcomcaneta.jpg';
import profilePhoto from '../assets/images/perfilolhandoparalonge.jpg';

const description =
  'Conheça a Dra. Ligiana Maffini Romanus, médica de família e comunidade em Curitiba, com mais de 20 anos de experiência clínica e clínica particular desde 2024.';

const gallery = [
  {
    src: portraitPhoto,
    alt: 'Retrato frontal da Dra. Ligiana Maffini',
  },
  {
    src: penPhoto,
    alt: 'Dra. Ligiana Maffini em consultório, com prontuário',
  },
  {
    src: profilePhoto,
    alt: 'Dra. Ligiana Maffini em perfil, olhando para o horizonte',
  },
];
---

<BaseLayout title="Sobre" description={description} path="/sobre">
  <section class="hero-glow border-b border-rose-soft/70">
    <div class="container-site py-16 md:py-24">
      <p class="eyebrow" data-hero-eyebrow>Sobre</p>
      <h1 class="heading-display mt-3 max-w-3xl" data-hero-title>Dra. Ligiana Maffini</h1>
      <p class="mt-3 max-w-2xl text-sm text-ink-soft" data-hero-subtitle>
        {site.fullName} · {site.specialty}
      </p>
    </div>
  </section>

  <section class="container-site py-16 md:py-24">
    <div class="grid gap-12 lg:grid-cols-[0.95fr_1.05fr] lg:items-start">
      <figure class="lg:sticky lg:top-28" data-hero-media>
        <div class="overflow-hidden rounded-[2rem] border border-rose-soft bg-surface shadow-md shadow-rose/10">
          <div data-parallax>
            <Photo
              src={aboutPhoto}
              alt="Dra. Ligiana Maffini em retrato profissional de corpo inteiro, com jaleco branco"
            />
          </div>
        </div>
      </figure>

      <div data-reveal>
        <p class="prose-site">
          Médica de família e comunidade, a Dra. Ligiana construiu sua trajetória ao longo de mais
          de duas décadas de prática clínica em Curitiba, com experiência em atenção primária,
          incluindo atuação no SUS e na Prefeitura.
        </p>
        <p class="prose-site mt-4">
          Formada pela Universidade Mackenzie e com especialização pela Evangélica do Paraná, une
          rigor técnico a uma escuta atenta. Em 2024, inaugurou sua clínica particular para
          aprofundar o cuidado em estilo de vida, longevidade e saúde integral.
        </p>
        <p class="prose-site mt-4">
          Seu consultório no bairro Cristo Rei recebe pacientes que buscam consultas longas,
          continuidade no acompanhamento e uma abordagem que considera corpo, mente e rotina,
          com especial atenção às mulheres a partir dos 40 anos.
        </p>

        <dl class="mt-10 grid gap-4 sm:grid-cols-2">
          <div class="card-soft" data-stagger-item>
            <dt class="text-xs uppercase tracking-widest text-rose-deep">Registro</dt>
            <dd class="mt-2 font-medium text-ink">{site.crm}</dd>
          </div>
          <div class="card-soft" data-stagger-item>
            <dt class="text-xs uppercase tracking-widest text-rose-deep">Especialidade</dt>
            <dd class="mt-2 font-medium text-ink">{site.rqe}</dd>
          </div>
          <div class="card-soft sm:col-span-2" data-stagger-item>
            <dt class="text-xs uppercase tracking-widest text-rose-deep">Formação</dt>
            <dd class="mt-2 font-medium text-ink">Universidade Mackenzie · Evangélica do Paraná</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="section-rose border-t border-rose-soft/70">
    <div class="container-site py-16 md:py-20">
      <p class="eyebrow" data-eyebrow>Na clínica</p>
      <h2 class="heading-section mt-3 max-w-xl" data-section-title>Um ambiente pensado para acolher</h2>
      <div class="mt-8 flip-gallery-stack" data-flip-grid data-services-grid>
        {
          gallery.map((item) => (
            <figure class="w-full max-w-sm overflow-hidden rounded-2xl border border-rose-soft shadow-sm shadow-rose/10 sm:max-w-none" data-flip-item data-service-card>
              <Photo src={item.src} alt={item.alt} aspect="square" />
            </figure>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
