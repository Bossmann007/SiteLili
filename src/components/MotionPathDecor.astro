---
interface Props {
  pathId?: string;
  dotClass?: string;
}

const { pathId = 'motion-path-curve', dotClass = '' } = Astro.props;
---

<div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true" data-motion-path-wrap>
  <svg
    class="absolute -right-8 top-0 h-[115%] w-[min(52vw,22rem)] text-rose/25 md:-right-4 md:w-[min(44vw,26rem)]"
    viewBox="0 0 320 640"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      id={pathId}
      d="M280 24 C120 120 260 240 80 360 S300 520 60 620"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
    ></path>
  </svg>
  <span
    class:list={[
      'absolute left-0 top-0 h-3 w-3 rounded-full bg-gold opacity-90 shadow-[0_0_12px_oklch(0.72_0.11_85_/_0.55)]',
      dotClass,
    ]}
    data-motion-dot
  ></span>
</div>
