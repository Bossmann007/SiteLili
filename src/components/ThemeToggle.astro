<button
  type="button"
  class="theme-toggle relative inline-flex min-h-11 min-w-11 cursor-pointer items-center justify-center rounded-full border border-line bg-surface/90 text-ink-soft backdrop-blur transition-colors hover:border-gold hover:text-gold-deep focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold"
  data-theme-toggle
  aria-label="Alternar modo claro e escuro"
  title="Alternar tema"
>
  <svg class="theme-icon theme-icon-sun absolute opacity-0 transition-opacity duration-200" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" stroke-linecap="round"></path>
  </svg>
  <svg class="theme-icon theme-icon-moon absolute opacity-0 transition-opacity duration-200" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
</button>

<style is:global>
  [data-theme='light'] .theme-icon-sun {
    opacity: 1;
  }

  [data-theme='dark'] .theme-icon-moon {
    opacity: 1;
  }
</style>
