---
import Photo from './Photo.astro';
import type { ImageMetadata } from 'astro';

interface GalleryItem {
  src: ImageMetadata;
  alt: string;
  caption: string;
}

interface Props {
  title: string;
  eyebrow?: string;
  items: GalleryItem[];
}

const { title, eyebrow = 'Na clínica', items } = Astro.props;
---

<section class="relative bg-ink text-surface" data-h-scroll-section>
  <div class="flex min-h-dvh flex-col justify-center py-16 md:py-24">
    <div class="container-site mb-10">
      <p class="text-xs uppercase tracking-[0.3em] text-rose-soft">{eyebrow}</p>
      <h2 class="mt-3 font-mega text-3xl uppercase tracking-tight md:text-5xl" data-section-title>{title}</h2>
    </div>
    <div class="overflow-hidden pl-5 sm:pl-8">
      <div class="flex w-max gap-5 pr-8 md:gap-6" data-h-scroll-track>
        {
          items.map((item) => (
            <figure class="w-[72vw] shrink-0 sm:w-[340px] md:w-[380px]">
              <div class="overflow-hidden rounded-2xl border border-white/10">
                <Photo src={item.src} alt={item.alt} aspect="wide" class="scale-105" />
              </div>
              <figcaption class="mt-3 text-xs uppercase tracking-[0.2em] text-white/60">{item.caption}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </div>
</section>
