---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  loading?: 'eager' | 'lazy';
  priority?: boolean;
  aspect?: 'portrait' | 'square' | 'wide' | 'fill';
}

const {
  src,
  alt,
  class: className = '',
  loading = 'lazy',
  priority = false,
  aspect = 'portrait',
} = Astro.props;

const widths = [480, 640, 960, 1280] as const;
const variants = await Promise.all(
  widths.map((width) => getImage({ src, width, format: 'webp', quality: 82 })),
);
const srcset = variants.map((variant, index) => `${variant.src} ${widths[index]}w`).join(', ');
const img = variants[variants.length - 1]!;

const aspectClass =
  aspect === 'fill'
    ? 'h-full w-full'
    : aspect === 'square'
      ? 'aspect-square'
      : aspect === 'wide'
        ? 'aspect-[16/10]'
        : 'aspect-[4/5]';
---

<img
  src={img.src}
  srcset={srcset}
  sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 640px"
  alt={alt}
  width={img.attributes.width}
  height={img.attributes.height}
  class:list={[aspectClass, 'h-full w-full object-cover', className]}
  loading={priority ? 'eager' : loading}
  decoding="async"
  fetchpriority={priority ? 'high' : undefined}
/>
