---
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  loading?: 'eager' | 'lazy';
  priority?: boolean;
  aspect?: 'portrait' | 'square' | 'wide' | 'fill';
}

const {
  src,
  alt,
  class: className = '',
  loading = 'lazy',
  priority = false,
  aspect = 'portrait',
} = Astro.props;

const aspectClass =
  aspect === 'fill'
    ? 'h-full w-full'
    : aspect === 'square'
      ? 'aspect-square'
      : aspect === 'wide'
        ? 'aspect-[16/10]'
        : 'aspect-[4/5]';
---

<img
  src={src.src}
  width={src.width}
  height={src.height}
  alt={alt}
  class:list={[aspectClass, 'h-full w-full object-cover', className]}
  loading={priority ? 'eager' : loading}
  decoding="async"
/>
