---
import { site, bio, availableLanguages } from '../data/site';
import { withTrailingSlash } from '../lib/paths';

type FaqItem = {
  question: string;
  answer: string;
};

interface Props {
  title: string;
  description: string;
  path?: string;
  /** When set, replaces global FAQ schema. Use `null` to omit FAQPage. */
  faqItems?: readonly FaqItem[] | null;
  includeMedicalWebPage?: boolean;
}

const { description, path = '', faqItems, includeMedicalWebPage = false } = Astro.props;
const pagePath = withTrailingSlash(path);
const pageUrl = new URL(pagePath, site.url).href;
const imageUrl = new URL('/og.jpg', site.url).href;
const physicianId = `${site.url}/#physician`;
const websiteId = `${site.url}/#website`;
const orgId = `${site.url}/#organization`;

const postalAddress = {
  '@type': 'PostalAddress',
  streetAddress: `${site.address.street}, ${site.address.neighborhood}`,
  addressLocality: site.address.city,
  addressRegion: site.address.state,
  postalCode: site.address.zip,
  addressCountry: site.address.country,
};

const parana = {
  '@type': 'State',
  name: 'Paraná',
  addressCountry: 'BR',
};

const areaServed = [
  {
    '@type': 'AdministrativeArea',
    name: site.serviceArea.administrativeArea,
    containedInPlace: parana,
  },
  ...site.serviceArea.cities.map((name) => ({
    '@type': 'City',
    name,
    containedInPlace: parana,
  })),
];

const mapUrl = `https://www.google.com/maps/search/?api=1&query=${site.mapQuery}`;

const breadcrumbItems = (() => {
  const items: { name: string; item: string }[] = [
    { name: 'Início', item: new URL('/', site.url).href },
  ];
  if (pagePath === '/') return items;

  const segments = pagePath.split('/').filter(Boolean);
  let acc = '';
  for (const segment of segments) {
    acc += `/${segment}`;
    const href = new URL(withTrailingSlash(acc), site.url).href;
    const label =
      segment === 'especialidades'
        ? 'Especialidades'
        : segment === 'pilares'
          ? 'Pilares MEV'
          : segment === 'sobre'
            ? 'Sobre'
            : segment === 'abordagem'
              ? 'Abordagem'
              : segment === 'contato'
                ? 'Contato'
                : segment === 'privacidade'
                  ? 'Privacidade'
                  : Astro.props.title;
    items.push({ name: label, item: href });
  }
  return items;
})();

const graph: Record<string, unknown>[] = [
  {
    '@type': 'Physician',
    '@id': physicianId,
    name: site.fullName,
    alternateName: site.doctor,
    medicalSpecialty: 'https://schema.org/PrimaryCare',
    knowsAbout: [
      'Medicina de Família e Comunidade',
      'Medicina do Estilo de Vida',
    ],
    knowsLanguage: [...availableLanguages],
    contactPoint: {
      '@type': 'ContactPoint',
      telephone: site.phoneTel,
      email: site.email,
      contactType: 'customer service',
      availableLanguage: [...availableLanguages],
      areaServed,
    },
    description: bio,
    url: site.url,
    image: imageUrl,
    telephone: site.phoneTel,
    email: site.email,
    alumniOf: {
      '@type': 'CollegeOrUniversity',
      name: 'Faculdade Evangélica de Medicina do Paraná',
    },
    hasCredential: [
      { '@type': 'EducationalOccupationalCredential', credentialCategory: 'CRM', name: site.crm },
      { '@type': 'EducationalOccupationalCredential', credentialCategory: 'RQE', name: site.rqe },
      {
        '@type': 'EducationalOccupationalCredential',
        credentialCategory: 'Título de Especialista',
        name: 'Medicina de Família e Comunidade, SBMFC (2024)',
      },
      {
        '@type': 'EducationalOccupationalCredential',
        credentialCategory: 'Formação',
        name: 'Medicina do Estilo de Vida, MevClinic e MevChange (MEV Brasil)',
      },
    ],
    address: postalAddress,
    areaServed,
    sameAs: site.sameAs,
    worksFor: { '@id': orgId },
    workLocation: { '@id': orgId },
  },
  {
    '@type': 'MedicalBusiness',
    '@id': orgId,
    name: site.name,
    url: site.url,
    logo: new URL(site.logo.horizontal, site.url).href,
    image: imageUrl,
    telephone: site.phoneTel,
    email: site.email,
    medicalSpecialty: 'https://schema.org/PrimaryCare',
    address: postalAddress,
    areaServed,
    hasMap: mapUrl,
    sameAs: site.sameAs,
    founder: { '@id': physicianId },
    employee: { '@id': physicianId },
  },
  {
    '@type': 'WebSite',
    '@id': websiteId,
    name: site.name,
    url: site.url,
    inLanguage: 'pt-BR',
    publisher: { '@id': orgId },
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${pageUrl}#breadcrumb`,
    itemListElement: breadcrumbItems.map((entry, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: entry.name,
      item: entry.item,
    })),
  },
];

if (includeMedicalWebPage) {
  graph.push({
    '@type': 'MedicalWebPage',
    '@id': `${pageUrl}#webpage`,
    name: Astro.props.title,
    description,
    url: pageUrl,
    inLanguage: 'pt-BR',
    isPartOf: { '@id': websiteId },
    author: { '@id': physicianId },
    about: { '@id': physicianId },
  });
}

const resolvedFaq = faqItems === undefined ? null : faqItems;
if (resolvedFaq && resolvedFaq.length > 0) {
  graph.push({
    '@type': 'FAQPage',
    '@id': `${pageUrl}#faq`,
    mainEntity: resolvedFaq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer },
    })),
  });
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': graph,
};
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
