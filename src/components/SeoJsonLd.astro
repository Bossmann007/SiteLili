---
import { site, bio } from '../data/site';
import { photos } from '../data/photos';

type FaqItem = {
  question: string;
  answer: string;
};

interface Props {
  title: string;
  description: string;
  path?: string;
  /** When set, replaces global FAQ schema. Use `null` to omit FAQPage. */
  faqItems?: readonly FaqItem[] | null;
  includeMedicalWebPage?: boolean;
}

const { description, path = '', faqItems, includeMedicalWebPage = false } = Astro.props;
const pageUrl = new URL(path || '/', site.url).href;
const imageUrl = new URL(photos.hero.src, site.url).href;

const postalAddress = {
  '@type': 'PostalAddress',
  streetAddress: `${site.address.street}, ${site.address.neighborhood}`,
  addressLocality: site.address.city,
  addressRegion: site.address.state,
  postalCode: site.address.zip,
  addressCountry: site.address.country,
};

const physician = {
  '@context': 'https://schema.org',
  '@type': 'Physician',
  name: site.fullName,
  alternateName: site.doctor,
  medicalSpecialty: ['Family Medicine', 'Lifestyle Medicine'],
  description: bio,
  url: site.url,
  image: imageUrl,
  telephone: site.phoneTel,
  email: site.email,
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Faculdade Evangélica de Medicina do Paraná',
  },
  hasCredential: [
    { '@type': 'EducationalOccupationalCredential', credentialCategory: 'CRM', name: site.crm },
    { '@type': 'EducationalOccupationalCredential', credentialCategory: 'RQE', name: site.rqe },
    {
      '@type': 'EducationalOccupationalCredential',
      credentialCategory: 'Título de Especialista',
      name: 'Medicina de Família e Comunidade, SBMFC (2024)',
    },
  ],
  address: postalAddress,
  sameAs: site.sameAs,
  worksFor: {
    '@type': 'MedicalClinic',
    name: site.name,
    url: site.url,
  },
};

const medicalClinic = {
  '@context': 'https://schema.org',
  '@type': 'MedicalClinic',
  name: site.name,
  description,
  url: site.url,
  telephone: site.phoneTel,
  email: site.email,
  image: imageUrl,
  logo: new URL(site.logo.horizontal, site.url).href,
  address: postalAddress,
  sameAs: site.sameAs,
  founder: {
    '@type': 'Physician',
    name: site.fullName,
    url: site.url,
  },
};

const medicalWebPage = includeMedicalWebPage
  ? {
      '@context': 'https://schema.org',
      '@type': 'MedicalWebPage',
      name: Astro.props.title,
      description,
      url: pageUrl,
      inLanguage: 'pt-BR',
      isPartOf: { '@type': 'WebSite', name: site.name, url: site.url },
      author: {
        '@type': 'Physician',
        name: site.fullName,
        url: site.url,
      },
      lastReviewed: '2026-08-30',
    }
  : null;

const resolvedFaq = faqItems === undefined ? null : faqItems;
---

<script type="application/ld+json" set:html={JSON.stringify(physician)} />
<script type="application/ld+json" set:html={JSON.stringify(medicalClinic)} />
{medicalWebPage && <script type="application/ld+json" set:html={JSON.stringify(medicalWebPage)} />}
{
  resolvedFaq && resolvedFaq.length > 0 && (
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: resolvedFaq.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: { '@type': 'Answer', text: item.answer },
        })),
      })}
    />
  )
}
