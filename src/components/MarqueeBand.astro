---
import { site } from '../data/site';

const items = [
  site.specialtyShort,
  `${site.address.city} · PR`,
  site.crm,
  'Consultas longas',
  'Saúde integral',
  'Mulheres 40+',
  'Longevidade',
  'Teleconsulta',
];
---

<div class="marquee-band overflow-hidden border-y border-line bg-gold py-3 text-surface" data-marquee aria-hidden="true">
  <div class="motion-track motion-track--rtl" data-motion-track="marquee">
    <div class="motion-group items-center gap-8 pr-8">
      {
        items.map((item) => (
          <span class="whitespace-nowrap text-xs font-medium uppercase tracking-[0.35em] md:text-sm">
            {item}
            <span class="mx-4 text-gold-soft">◆</span>
          </span>
        ))
      }
    </div>
    <div class="motion-group items-center gap-8 pr-8" aria-hidden="true">
      {
        items.map((item) => (
          <span class="whitespace-nowrap text-xs font-medium uppercase tracking-[0.35em] md:text-sm">
            {item}
            <span class="mx-4 text-gold-soft">◆</span>
          </span>
        ))
      }
    </div>
  </div>
</div>
